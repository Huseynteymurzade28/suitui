include "termio"
include "key"
include "color"

$Tui = { version = "0.0.2" }

Tui.ESC = TermIO.char(27)
Tui.CSI = Tui.ESC + "["

Tui.CONT = TermIO.char(128)
Tui.LEAD = TermIO.char(192)

Tui.size = TermIO.size
Tui.ready = false
Tui.changed = 0
Tui.dirty = false
Tui.x = 0
Tui.y = 0

Tui.resize = define(w, h)
    Tui.w = w
    Tui.h = h
    Tui.chars = []
    Tui.styles = []
    Tui.shown = []
    Tui.shownst = []
    for i in w * h
        Tui.chars->push(" ")
        Tui.styles->push("0")
        Tui.shown->push(" ")
        Tui.shownst->push("0")
    Tui.dirty = true

Tui.init = define()
    csi = Tui.CSI
    TermIO.raw(csi + "0m" + csi + "?25h" + csi + "?1049l")
    TermIO.write(csi + "?1049h" + csi + "?25l" + csi + "2J")
    TermIO.flush()
    s = TermIO.size()
    Tui.resize(s.w, s.h)
    Tui.ready = true

Tui.quit = define()
    Tui.ready = false
    TermIO.restore()

Tui.clear = define()
    for i in Tui.w * Tui.h
        Tui.chars[i] = " "
        Tui.styles[i] = "0"
    Tui.dirty = true

Tui.move = define(x, y)
    Tui.x = x
    Tui.y = y

Tui.write = define(s)
    row = Tui.y * Tui.w
    inside = Tui.y >= 0 and Tui.y < Tui.h
    i = -1
    for b in s
        if b >= Tui.CONT and not (b >= Tui.LEAD)
            if i != -1 then Tui.chars[i] += b
        else
            i = -1
            if inside and Tui.x >= 0 and Tui.x < Tui.w
                i = row + Tui.x
                Tui.chars[i] = b
                Tui.styles[i] = Tui.style
            Tui.x += 1
    Tui.dirty = true

Tui.flush = define()
    Tui.changed = 0
    if not Tui.ready or not Tui.dirty then return TermIO.flush()
    Tui.dirty = false
    w = Tui.w
    style = ""
    at = -1
    n = 0
    for i in w * Tui.h
        ch = Tui.chars[i]
        st = Tui.styles[i]
        if ch != Tui.shown[i] or st != Tui.shownst[i]
            if i != at
                TermIO.write(Tui.CSI + string(i / w + 1) + ";" + string(i % w + 1) + "H")
            if st != style
                TermIO.write(Tui.CSI + st + "m")
                style = st
            TermIO.write(ch)
            Tui.shown[i] = ch
            Tui.shownst[i] = st
            at = i + 1
            if at % w == 0 then at = -1
            n += 1
    if n > 0 then TermIO.write(Tui.CSI + "0m")
    TermIO.flush()
    Tui.changed = n

Tui.pollkey = define(ms)
    Tui.flush()
    key = Key.read(ms)
    if key == "resize"
        s = TermIO.size()
        Tui.resize(s.w, s.h)
        TermIO.write(Tui.CSI + "2J")
    return key

Tui.readkey = define()
    return Tui.pollkey(-1)

Tui.pen = { fg = "", bg = "", attrs = "" }
Tui.style = "0"

Tui.restyle = define()
    st = "0" + Tui.pen.attrs
    if Tui.pen.fg != "" then st += ";" + Tui.pen.fg
    if Tui.pen.bg != "" then st += ";" + Tui.pen.bg
    Tui.style = st

Tui.fg = define(c)
    Tui.pen.fg = Color.sgr(c, 30)
    Tui.restyle()

Tui.bg = define(c)
    Tui.pen.bg = Color.sgr(c, 40)
    Tui.restyle()

Tui.reset = define()
    Tui.pen = { fg = "", bg = "", attrs = "" }
    Tui.style = "0"

Tui.ATTRS = { bold = 1, dim = 2, italic = 3, underline = 4, reverse = 7, strike = 9 }

Tui.attr = define(name)
    Tui.pen.attrs += ";" + string(Tui.ATTRS[name])
    Tui.restyle()

Tui.repeat = define(s, n)
    out = ""
    while n > 0
        out += s
        n -= 1
    return out

Tui.BORDERS = {
    single = ["─", "│", "┌", "┐", "└", "┘"],
    rounded = ["─", "│", "╭", "╮", "╰", "╯"],
    double = ["═", "║", "╔", "╗", "╚", "╝"],
    thick = ["━", "┃", "┏", "┓", "┗", "┛"],
}
Tui.edges = Tui.BORDERS.rounded

Tui.border = define(name)
    Tui.edges = Tui.BORDERS[name]

Tui.box = define(x, y, w, h, title)
    e = Tui.edges
    top = Tui.repeat(e[0], w - 2)
    if title != null
        top = e[0] + " " + title + " " + Tui.repeat(e[0], w - 5 - title->len())
    Tui.move(x, y)
    Tui.write(e[2] + top + e[3])
    i = 1
    while i < h - 1
        Tui.move(x, y + i)
        Tui.write(e[1])
        Tui.move(x + w - 1, y + i)
        Tui.write(e[1])
        i += 1
    Tui.move(x, y + h - 1)
    Tui.write(e[4] + Tui.repeat(e[0], w - 2) + e[5])
