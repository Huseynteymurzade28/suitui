include "termio"
include "key"
include "color"

$Tui = { version = "0.0.2" }

Tui.ESC = TermIO.char(27)
Tui.CSI = Tui.ESC + "["

Tui.size = TermIO.size
Tui.write = TermIO.write
Tui.flush = TermIO.flush

Tui.init = define()
    csi = Tui.CSI
    TermIO.raw(csi + "0m" + csi + "?25h" + csi + "?1049l")
    TermIO.write(csi + "?1049h" + csi + "?25l" + csi + "2J")
    TermIO.flush()

Tui.quit = define()
    TermIO.restore()

Tui.clear = define()
    TermIO.write(Tui.CSI + "2J")

Tui.move = define(x, y)
    TermIO.write(Tui.CSI + string(y + 1) + ";" + string(x + 1) + "H")

Tui.readkey = define()
    TermIO.flush()
    return Key.read()

Tui.fg = define(c)
    TermIO.write(Tui.CSI + Color.sgr(c, 30) + "m")

Tui.bg = define(c)
    TermIO.write(Tui.CSI + Color.sgr(c, 40) + "m")

Tui.reset = define()
    TermIO.write(Tui.CSI + "0m")

Tui.ATTRS = { bold = 1, dim = 2, italic = 3, underline = 4, reverse = 7, strike = 9 }

Tui.attr = define(name)
    TermIO.write(Tui.CSI + string(Tui.ATTRS[name]) + "m")

Tui.repeat = define(s, n)
    out = ""
    while n > 0
        out += s
        n -= 1
    return out
