$Chart = {}

Chart.fmt = define(v)
    if typeof(v) == "integer" then return string(v)
    sign = ""
    if v < 0
        sign = "-"
        v = -v
    if v >= 10 then return sign + string(integer(v + 0.5))
    n = integer(v * 10 + 0.5)
    return sign + string(n / 10) + "." + string(n % 10)

Chart.series = define(self, name, color)
    s = { name = name, color = color, fill = null, values = [] }
    self.list->push(s)
    return s

Chart.range = define(self, n)
    lo = null
    hi = null
    for s in self.list
        vs = s.values
        from = vs->len() - n
        if from < 0 then from = 0
        for i in vs->len() - from
            v = vs[from + i]
            if lo == null or v < lo then lo = v
            if hi == null or v > hi then hi = v
    if lo == null
        lo = 0
        hi = 1
    if self.min != null then lo = self.min
    if self.max != null then hi = self.max
    if hi <= lo then hi = lo + 1
    return [lo, hi]

Chart.labels = define(self, lo, hi, ph)
    out = []
    for r in ph
        out->push("")
    out[0] = self.fmt(hi)
    out[ph - 1] = self.fmt(lo)
    if ph >= 5 then out[(ph - 1) / 2] = self.fmt(hi - (hi - lo) * ((ph - 1) / 2) / (ph - 1.0))
    return out

Chart.plot = define(self, d, s, lo, hi, n, fill)
    vs = s.values
    from = vs->len() - n
    if from < 0 then from = 0
    px = null
    py = null
    for i in vs->len() - from
        cx = n - (vs->len() - from) + i
        cy = (d.h - 1) - (vs[from + i] - lo) * (d.h - 1.0) / (hi - lo)
        if fill
            for k in d.h - integer(cy)
                d->set(cx, integer(cy) + k, s.fill)
        else if px == null
            d->set(cx, cy, s.color)
        else
            d->line(px, py, cx, cy, s.color)
        px = cx
        py = cy

Chart.draw = define(self, x, y, w, h)
    self.area = [x, y, w, h]
    ph = h - 1
    if ph < 2 then return null
    lw = 0
    pw = w
    for pass in 2
        r = self->range(pw * 2)
        labels = self->labels(r[0], r[1], ph)
        lw = 0
        for s in labels
            if Utf8.width(s) > lw then lw = Utf8.width(s)
        pw = w - lw - 1
    if pw < 1 then return null
    d = self.dots
    if d == null or d.cw != pw or d.ch != ph
        d = Dots.new(pw * 2, ph * 4)
        self.dots = d
    else
        d->clear()
    lo = r[0]
    hi = r[1]
    n = d.w
    for s in self.list
        if s.fill != null then self->plot(d, s, lo, hi, n, true)
    for s in self.list
        self->plot(d, s, lo, hi, n, false)
    d->draw(x + lw + 1, y, pw, ph)
    Tui.fg(self.axis)
    for r in ph
        Tui.move(x, y + r)
        s = labels[r]
        Tui.write(Tui.repeat(" ", lw - Utf8.width(s)) + s)
        if s == ""
            Tui.write("│")
        else
            Tui.write("┤")
    Tui.move(x, y + ph)
    Tui.write(Tui.repeat(" ", lw) + "└" + Tui.repeat("─", pw))
    Tui.reset()
    if self.legend then self->key(x + lw + 1, y, pw)

Chart.key = define(self, x, y, w)
    size = 0
    for s in self.list
        size += Utf8.width(s.name) + 4
    if size > w then return null
    Tui.move(x + w - size, y)
    for s in self.list
        Tui.write(" ")
        Tui.fg(s.color)
        Tui.write("● ")
        Tui.fg(self.axis)
        Tui.write(s.name + " ")
    Tui.reset()

Chart.new = define()
    c = { list = [], min = null, max = null, axis = "bright_black", legend = true, dots = null, area = [0, 0, 0, 0] }
    c.series = Chart.series
    c.range = Chart.range
    c.labels = Chart.labels
    c.fmt = Chart.fmt
    c.plot = Chart.plot
    c.key = Chart.key
    c.draw = Chart.draw
    return c

$Sparkline = {}

Sparkline.BARS = ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]

Sparkline.draw = define(self, x, y, w, h)
    self.area = [x, y, w, h]
    vs = self.values
    from = vs->len() - w
    if from < 0 then from = 0
    lo = self.min
    hi = self.max
    for i in vs->len() - from
        v = vs[from + i]
        if lo == null or v < lo then lo = v
        if hi == null or v > hi then hi = v
    if self.min != null then lo = self.min
    if self.max != null then hi = self.max
    Tui.move(x + w - (vs->len() - from), y)
    Tui.fg(self.color)
    for i in vs->len() - from
        k = 0
        if hi > lo then k = integer((vs[from + i] - lo) * 7.0 / (hi - lo) + 0.5)
        if k < 0 then k = 0
        if k > 7 then k = 7
        Tui.put(Sparkline.BARS[k])
    Tui.reset()
    Tui.dirty = true

Sparkline.new = define(color)
    return { values = [], color = color, min = null, max = null, area = [0, 0, 0, 0], draw = Sparkline.draw }
