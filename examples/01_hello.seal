include "../tui"

define $center(y, text)
    s = Tui.size()
    Tui.move((s.w - Tui.width(text)) / 2, y)
    Tui.write(text)

Tui.init()
s = Tui.size()
w = 34
h = 7
x = (s.w - w) / 2
y = (s.h - h) / 2

Tui.box(x, y, w, h, "suitui")
center(y + 2, "Hello, Seal")
center(y + 4, "press q to quit")

while Tui.readkey() != "q"
    skip

Tui.quit()
