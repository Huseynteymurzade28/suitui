include "../term"

define $rep(s, n)
    out = ""
    i = 0
    while i < n
        out = out + s
        i = i + 1
    return out

define $box(x, y, w, h, title)
    Term.move(x, y)
    Term.write("╭─ " + title + " " + rep("─", w - 5 - title->len()) + "╮")
    i = 1
    while i < h - 1
        Term.move(x, y + i)
        Term.write("│" + rep(" ", w - 2) + "│")
        i = i + 1
    Term.move(x, y + h - 1)
    Term.write("╰" + rep("─", w - 2) + "╯")

define $center(y, text)
    s = Term.size()
    Term.move((s.w - text->len()) / 2, y)
    Term.write(text)

Term.init()
s = Term.size()
w = 34
h = 7
x = (s.w - w) / 2
y = (s.h - h) / 2

box(x, y, w, h, "suitui")
center(y + 2, "Hello, Seal")
center(y + 4, "press q to quit")

while Term.readkey() != "q"
    skip

Term.quit()
