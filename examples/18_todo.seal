include "../tui"
include "io"
include "system"

$BLUE = "#8ecae6"
$PINK = "#ff8fab"
$GREEN = "#95d5b2"

$PATH = System.getenv("TODO_FILE")
if PATH == null then PATH = System.getenv("HOME") + "/.seal_todo"

$TASKS = []
$FILTERS = ["all", "open", "done"]
$S = { shown = [], filter = 0, editing = -1 }

define $load()
    f = IO.open(PATH, "r")
    if f == null
        for text in ["feed the seals", "fix the boat engine", "count the pups on the north beach", "buy more herring"]
            TASKS->push({ text = text, done = false })
        return null
    for line in Tui.lines(f->read())
        if line->len() > 2 then TASKS->push({ text = line->sub(2), done = line->startwith("x") })
    f->close()

define $save()
    f = IO.open(PATH, "w")
    if f == null then return null
    for t in TASKS
        mark = "- "
        if t.done then mark = "x "
        f->write(mark + t.text + "\n")
    f->close()

define $paint(self, at)
    t = TASKS[S.shown[at]]
    if not t.done then return null
    if at != self.selected then Tui.fg("bright_black")
    Tui.attr("strike")

$INPUT = TextInput.new("what needs doing?")
$LIST = ListView.new([])
LIST.hi = BLUE
LIST.paint = paint
$FOCUS = Focus.new([LIST, INPUT])

define $boxed(title, child, fg)
    b = Box.new(title, child)
    b.fg = "bright_black"
    b.hi = fg
    return b

define $text(fg)
    l = Label.new("")
    l.fg = fg
    return l

$TITLE = Label.new(" 🦭 seal todo")
$TABS = text("bright_black")
TABS.align = "right"
$PROGRESS = text(GREEN)
$HINT = text("bright_black")
HINT.align = "center"
$ADD = boxed("new task", INPUT, PINK)
$TASKBOX = boxed("tasks", LIST, BLUE)
TASKBOX.pad = 0

$ROOT = Col.new([
    [Row.new([[TITLE, "fill"], [TABS, 30]]), 1],
    [ADD, 3],
    [TASKBOX, "fill"],
    [Row.new([[null, 1], [PROGRESS, "fill"], [null, 1]]), 1],
    [HINT, 1],
])

define $refresh()
    S.shown = []
    LIST.items = []
    for i in TASKS->len()
        t = TASKS[i]
        f = FILTERS[S.filter]
        if f == "all" or (f == "done") == t.done
            S.shown->push(i)
            mark = "○ "
            if t.done then mark = "✓ "
            LIST.items->push(mark + t.text)
    if LIST.selected >= S.shown->len() then LIST.selected = S.shown->len() - 1
    if LIST.selected < 0 then LIST.selected = 0

define $current()
    if S.shown->len() == 0 then return -1
    return S.shown[LIST.selected]

define $toggle()
    at = current()
    if at < 0 then return null
    TASKS[at].done = not TASKS[at].done
    save()

define $remove()
    at = current()
    if at < 0 then return null
    TASKS->remove(at)
    save()

define $swap(step)
    at = current()
    if at < 0 or S.filter != 0 then return null
    to = at + step
    if to < 0 or to >= TASKS->len() then return null
    t = TASKS[at]
    TASKS[at] = TASKS[to]
    TASKS[to] = t
    LIST.selected = to
    save()

define $edit()
    at = current()
    if at < 0 then return null
    S.editing = at
    INPUT->set(TASKS[at].text)
    FOCUS->set(1)

define $submit()
    if INPUT.text == "" then return null
    if S.editing >= 0
        TASKS[S.editing].text = INPUT.text
        FOCUS->set(0)
    else
        TASKS->push({ text = INPUT.text, done = false })
        S.filter = 0
        refresh()
        LIST.selected = TASKS->len() - 1
    S.editing = -1
    INPUT->set("")
    save()

define $done()
    n = 0
    for t in TASKS
        if t.done then n += 1
    return n

define $scene()
    tabs = ""
    for i in FILTERS->len()
        name = FILTERS[i]
        if i == S.filter then name = "[" + name + "]"
        tabs += name + "  "
    TABS.text = tabs
    n = TASKS->len()
    d = done()
    TASKBOX.title = string(n - d) + " left"
    width = Tui.w - 14
    bar = 0
    if n > 0 then bar = width * d / n
    PROGRESS.text = Tui.repeat("█", bar) + Tui.repeat("░", width - bar) + "  " + string(d) + "/" + string(n)
    ADD.title = "new task"
    if S.editing >= 0 then ADD.title = "edit task"
    HINT.text = "a add · space done · e edit · d delete · J K move · f filter"
    if INPUT.focused then HINT.text = "enter save · esc back · tab to the list"
    Tui.clear()
    ROOT->draw(0, 0, Tui.w, Tui.h)

load()
refresh()
Tui.init()
Tui.track("click")
key = ""
while key != "ctrl+c"
    scene()
    key = Tui.readkey()
    if INPUT.focused
        if key == "enter"
            submit()
        else if key == "esc"
            S.editing = -1
            INPUT->set("")
            FOCUS->set(0)
        else
            FOCUS->key(key)
    else if key == "q" or key == "esc"
        stop
    else if key == "space" or key == "enter"
        toggle()
    else if key == "a" or key == "n"
        FOCUS->set(1)
    else if key == "e"
        edit()
    else if key == "d" or key == "delete"
        remove()
    else if key == "K" or key == "shift+up"
        swap(-1)
    else if key == "J" or key == "shift+down"
        swap(1)
    else if key == "f"
        S.filter = (S.filter + 1) % FILTERS->len()
    else
        FOCUS->key(key)
        if key == "click" and LIST.focused and Tui.hit(LIST) and Key.mouse.x == LIST.area[0] + 1
            toggle()
    refresh()
Tui.quit()
