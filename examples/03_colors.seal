include "../tui"

define $label(x, y, text)
    Tui.move(x, y)
    Tui.attr("dim")
    Tui.write(text)
    Tui.reset()

define $basic(x, y)
    label(x, y, "16 colors")
    i = 0
    while i < 8
        Tui.move(x + i * 4, y + 1)
        Tui.bg(Color.NAMES[i])
        Tui.write("    ")
        Tui.move(x + i * 4, y + 2)
        Tui.bg("bright_" + Color.NAMES[i])
        Tui.write("    ")
        i += 1
    Tui.reset()

define $cube(x, y)
    label(x, y, "256 colors")
    row = 0
    while row < 6
        Tui.move(x, y + 1 + row)
        col = 0
        while col < 36
            Tui.bg(16 + row * 36 + col)
            Tui.write(" ")
            col += 1
        row += 1
    Tui.move(x, y + 7)
    i = 232
    while i < 256
        Tui.bg(i)
        Tui.write(" ")
        i += 1
    Tui.reset()

define $rainbow(x, y, w)
    label(x, y, "truecolor")
    i = 0
    while i < w
        Tui.move(x + i, y + 1)
        Tui.fg(Color.hue(i * 360 / w))
        Tui.bg(Color.hue((i * 360 / w + 30) % 360))
        Tui.write("▀")
        i += 1
    Tui.reset()

define $styles(x, y)
    label(x, y, "styles")
    Tui.move(x, y + 1)
    names = ["bold", "dim", "italic", "underline", "reverse", "strike"]
    i = 0
    while i < names->len()
        Tui.attr(names[i])
        Tui.write(names[i])
        Tui.reset()
        Tui.write("  ")
        i += 1

Tui.init()
s = Tui.size()
x = (s.w - 52) / 2
y = (s.h - 20) / 2

Tui.move(x, y)
Tui.attr("bold")
Tui.fg("#ff8fab")
Tui.write("suitui")
Tui.reset()
Tui.write(" colors")
label(x + 43, y, "q to quit")

basic(x, y + 2)
cube(x, y + 6)
rainbow(x, y + 15, 52)
styles(x, y + 18)

while Tui.readkey() != "q"
    skip

Tui.quit()
