include "../tui"

define $box(x, y, w, h, title)
    Tui.move(x, y)
    Tui.write("╭─ " + title + " " + Tui.repeat("─", w - 5 - title->len()) + "╮")
    i = 1
    while i < h - 1
        Tui.move(x, y + i)
        Tui.write("│" + Tui.repeat(" ", w - 2) + "│")
        i = i + 1
    Tui.move(x, y + h - 1)
    Tui.write("╰" + Tui.repeat("─", w - 2) + "╯")

define $center(x, w, y, text)
    Tui.move(x + (w - text->len()) / 2, y)
    Tui.write(text)

Tui.init()
history = []
key = null

while key != "ctrl+c"
    s = Tui.size()
    w = 36
    h = 14
    x = (s.w - w) / 2
    y = (s.h - h) / 2

    Tui.clear()
    box(x, y, w, h, "keys")
    if key == null
        center(x, w, y + 3, "press something")
    else
        center(x, w, y + 3, "[ " + key + " ]")

    i = 0
    while i < history->len()
        center(x, w, y + 5 + i, history[i])
        i = i + 1
    center(x, w, y + h - 2, "ctrl+c to quit")
    Tui.flush()

    if key != null
        history->push(key)
        if history->len() > 6
            history->remove(0)
    key = Tui.readkey()

Tui.quit()
