include "../../tui"
include "system"
include "proc"

$GREEN = [126, 224, 129]
$YELLOW = [255, 209, 102]
$RED = [255, 92, 122]
$CYAN = [90, 216, 255]
$PURPLE = [179, 136, 255]
$PINK = [255, 143, 171]
$DIM = [70, 70, 90]
$TEXT = [200, 200, 215]
$PARTS = [" ", "▏", "▎", "▍", "▌", "▋", "▊", "▉", "█"]
$S = { frame = 0, cores = [], total = null, mem = null, load = null, up = 0, host = "", raw = [], tasks = [], full = false, follow = false }

define $mix(a, b, k)
    if k < 0 then k = 0
    if k > 1 then k = 1
    return [integer(a[0] + (b[0] - a[0]) * k), integer(a[1] + (b[1] - a[1]) * k), integer(a[2] + (b[2] - a[2]) * k)]

define $heat(k)
    if k < 0.5 then return mix(GREEN, YELLOW, k * 2)
    return mix(YELLOW, RED, k * 2 - 1)

define $cool(k)
    if k < 0.5 then return mix(CYAN, PURPLE, k * 2)
    return mix(PURPLE, PINK, k * 2 - 1)

define $two(n)
    if n < 10 then return "0" + string(n)
    return string(n)

define $size(k)
    if k >= 1024 * 1024
        n = integer(k * 10.0 / (1024 * 1024) + 0.5)
        return string(n / 10) + "." + string(n % 10) + "G"
    if k >= 1024 then return string(k / 1024) + "M"
    return string(k) + "K"

define $lpad(s, w)
    return Tui.repeat(" ", w - Tui.width(s)) + s

define $bar(x, y, w, k, paint)
    if k < 0 then k = 0
    if k > 1 then k = 1
    eighths = integer(k * w * 8 + 0.5)
    Tui.move(x, y)
    for i in w
        n = eighths - i * 8
        if n > 8 then n = 8
        if n <= 0
            Tui.fg(DIM)
            Tui.write("─")
        else
            Tui.fg(paint(i * 1.0 / w))
            Tui.write(PARTS[n])
    Tui.reset()

define $ease(v, t)
    return v + (t - v) * 0.25

define $core(name)
    spark = Sparkline.new(GREEN)
    spark.min = 0
    spark.max = 100
    return { name = name, now = 0.0, want = 0.0, spark = spark }

define $drawcore(c, x, y, w)
    Tui.move(x, y)
    Tui.fg(TEXT)
    Tui.write(lpad(c.name, 3) + " ")
    sw = w / 4
    bw = w - 4 - 5 - sw - 1
    bar(x + 4, y, bw, c.now, heat)
    Tui.move(x + 4 + bw, y)
    Tui.fg(heat(c.now))
    Tui.write(lpad(string(integer(c.now * 100 + 0.5)) + "%", 5))
    c.spark.color = heat(c.now)
    c.spark->draw(x + w - sw, y, sw, 1)

define $drawcpu(self, x, y, w, h)
    drawcore(S.total, x, y, w)
    half = (w - 2) / 2
    rows = (S.cores->len() + 1) / 2
    for i in S.cores->len()
        cx = x
        cy = y + 2 + i
        if i >= rows
            cx = x + half + 2
            cy = y + 2 + i - rows
        drawcore(S.cores[i], cx, cy, half)

define $label(x, y, name, value, color)
    Tui.move(x, y)
    Tui.fg(DIM)
    Tui.write(name)
    Tui.move(x + 8, y)
    Tui.fg(color)
    Tui.attr("bold")
    Tui.write(value)
    Tui.reset()

define $drawmem(self, x, y, w, h)
    m = S.mem
    label(x, y, "mem", size(m.used) + " / " + size(m.total), PURPLE)
    bar(x, y + 1, w, m.now, cool)
    label(x, y + 3, "swap", size(m.swapused) + " / " + size(m.swap), PINK)
    bar(x, y + 4, w, m.swapnow, cool)
    l = S.load
    label(x, y + 6, "load", l.avg[0] + "  " + l.avg[1] + "  " + l.avg[2], YELLOW)
    label(x, y + 7, "threads", string(l.total) + ", " + string(l.running) + " running", CYAN)
    up = S.up
    t = two(up / 3600 % 24) + ":" + two(up / 60 % 60) + ":" + two(up % 60)
    if up >= 86400 then t = string(up / 86400) + "d " + t
    label(x, y + 8, "uptime", t, GREEN)

define $drawtitle(self, x, y, w, h)
    Tui.move(x, y)
    Tui.fg(PINK)
    Tui.attr("bold")
    Tui.write(" 🦭 sealtop")
    Tui.reset()
    Tui.fg(DIM)
    Tui.write("  " + S.host)
    clock = System.date("%H:%M:%S")
    Tui.move(x + w - Tui.width(clock) - 1, y)
    Tui.fg(TEXT)
    Tui.write(clock)
    Tui.reset()

define $drawfoot(self, x, y, w, h)
    Tui.move(x, y)
    for k in [["q", "quit"], ["P", "cpu"], ["M", "mem"], ["T", "time"], ["N", "pid"], ["U", "user"], ["p", "path"]]
        Tui.bg(PINK)
        Tui.fg("black")
        Tui.write(" " + k[0] + " ")
        Tui.reset()
        Tui.fg(TEXT)
        Tui.write(" " + k[1] + "  ")
    Tui.reset()

define $bypid(t)
    return t.num

define $byuser(t)
    return t.user

define $bystate(t)
    return t.state

define $bythreads(t)
    return t.threads

define $bycpu(t)
    return t.cpu

define $bymem(t)
    return t.rss

define $byticks(t)
    return t.ticks

define $bycmd(t)
    return t.cmd

$SORTS = [bypid, byuser, bystate, bythreads, bycpu, bymem, bymem, byticks, bycmd]

define $fixed(v)
    n = integer(v * 10 + 0.5)
    return string(n / 10) + "." + string(n % 10)

define $cputime(ticks)
    m = ticks / 6000
    out = two(ticks / 100 % 60) + "." + two(ticks % 100)
    if m >= 60 then return string(m / 60) + "h" + two(m % 60) + ":" + out
    return string(m) + ":" + out

define $paintproc(self, at, c)
    if at == self.selected then return null
    t = S.tasks[at]
    if c == 1
        Tui.fg(TEXT)
        if t.user == "root" then Tui.fg(RED)
    if c == 2
        Tui.fg(DIM)
        if t.state == "R" then Tui.fg(GREEN)
    if c == 3 then Tui.fg(DIM)
    if c == 4
        Tui.fg(heat(t.cpu / 100))
        if t.cpu < 0.05 then Tui.fg(DIM)
    if c == 5
        Tui.fg(cool(t.mem / 10))
        if t.mem < 0.05 then Tui.fg(DIM)
    if c == 6 then Tui.fg(CYAN)
    if c == 7 then Tui.fg(DIM)
    if c == 8
        Tui.fg(TEXT)
        if String.startwith(t.cmd, "[") then Tui.fg(DIM)

define $apply()
    pid = null
    if S.follow and S.tasks->len() > PROCS.selected then pid = S.tasks[PROCS.selected].num
    tasks = Tui.sort(S.raw, SORTS[PROCS.sort])
    if PROCS.desc
        back = []
        i = tasks->len() - 1
        while i >= 0
            back->push(tasks[i])
            i -= 1
        tasks = back
    S.tasks = tasks
    rows = []
    for i in tasks->len()
        t = tasks[i]
        if t.num == pid then PROCS.selected = i
        cmd = t.cmd
        if not S.full then cmd = t.comm
        rows->push([string(t.num), t.user, t.state, string(t.threads), fixed(t.cpu), fixed(t.mem), size(t.rss), cputime(t.ticks), cmd])
    PROCS.items = rows
    S.sort = [PROCS.sort, PROCS.desc]

$PROCS = Table.new([
    ["PID", 7, "right"], ["USER", 9, "left"], ["S", 1, "left"], ["THR", 4, "right"], ["CPU%", 5, "right"],
    ["MEM%", 5, "right"], ["RES", 6, "right"], ["TIME+", 9, "right"], ["COMMAND", "fill", "left"],
])
PROCS.sort = 4
PROCS.headbg = [60, 50, 90]
PROCS.headfg = TEXT
PROCS.hi = PINK
PROCS.paint = paintproc
$LIST = Box.new("processes", PROCS)
LIST.fg = [140, 80, 110]
LIST.pad = 0

$HISTORY = Chart.new()
HISTORY.min = 0
HISTORY.max = 100
HISTORY.axis = DIM
$BUSY = HISTORY->series("cpu", GREEN)
BUSY.ramp = [[30, 70, 45], [70, 75, 40], [95, 40, 55]]
$USED = HISTORY->series("mem", PURPLE)

$CPU = Box.new("cpu", { draw = drawcpu })
CPU.fg = [80, 140, 95]
$MEM = Box.new("memory", { draw = drawmem })
MEM.fg = [120, 95, 170]
$GRAPH = Box.new("history", HISTORY)
GRAPH.fg = [70, 110, 140]
GRAPH.pad = 0

define $sample()
    cpu = Proc.cpu()
    if S.total == null
        S.total = core("all")
        for i in cpu->len() - 1
            S.cores->push(core(string(i)))
    all = [S.total]
    for c in S.cores
        all->push(c)
    for i in cpu->len()
        c = all[i]
        c.want = cpu[i].user + cpu[i].nice + cpu[i].sys
        c.spark.values->push(c.want * 100)
        if c.spark.values->len() > 60 then c.spark.values->remove(0)
    m = Proc.mem()
    if S.mem == null
        m.now = 0.0
        m.swapnow = 0.0
    else
        m.now = S.mem.now
        m.swapnow = S.mem.swapnow
    S.mem = m
    S.load = Proc.load()
    S.up = Proc.uptime()
    if S.frame % 32 == 0
        S.raw = Proc.procs(m.total, S.cores->len())
        apply()

define $animate()
    S.total.now = ease(S.total.now, S.total.want)
    for c in S.cores
        c.now = ease(c.now, c.want)
    m = S.mem
    m.now = ease(m.now, m.used * 1.0 / m.total)
    sw = 0.0
    if m.swap > 0 then sw = m.swapused * 1.0 / m.swap
    m.swapnow = ease(m.swapnow, sw)
    if S.frame % 3 == 0
        BUSY.values->push(S.total.now * 100)
        USED.values->push(m.now * 100)
        if BUSY.values->len() > 1000
            BUSY.values->remove(0)
            USED.values->remove(0)

S.host = Proc.lines("/proc/sys/kernel/hostname")[0]
S.sort = [4, true]
sample()
S.raw = Proc.procs(S.mem.total, S.cores->len())
apply()
rows = (S.cores->len() + 1) / 2
$ROOT = Col.new([
    [{ draw = drawtitle }, 1],
    [Row.new([[CPU, "fill"], [MEM, 38]]), rows + 4],
    [GRAPH, 8],
    [LIST, "fill"],
    [{ draw = drawfoot }, 1],
])

Tui.init()
Tui.track("click")
key = ""
while key != "q" and key != "ctrl+c" and key != "f10"
    S.frame += 1
    if S.frame % 8 == 0 then sample()
    animate()
    Tui.clear()
    ROOT->draw(0, 0, Tui.w, Tui.h)
    key = Tui.pollkey(33)
    if key != null
        if key == "P" then PROCS.sort = 4
        if key == "M" then PROCS.sort = 5
        if key == "T" then PROCS.sort = 7
        if key == "N" then PROCS.sort = 0
        if key == "U" then PROCS.sort = 1
        if key == "p"
            S.full = not S.full
            apply()
        if key == "<" then PROCS.sort = (PROCS.sort + 8) % 9
        if key == ">" then PROCS.sort = (PROCS.sort + 1) % 9
        if PROCS->key(key) then S.follow = true
        if PROCS.sort != S.sort[0] or PROCS.desc != S.sort[1] then apply()
Tui.quit()
