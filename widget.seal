$Label = {}

Label.draw = define(self, x, y, w, h)
    lines = self.text->split("\n")
    Tui.fg(self.fg)
    for i in lines->len()
        if i >= h then stop
        line = Utf8.fit(lines[i], w)
        pad = w - Utf8.width(line)
        if self.align == "left" then pad = 0
        if self.align == "center" then pad /= 2
        Tui.move(x + pad, y + i)
        Tui.write(line)
    Tui.reset()

Label.new = define(text)
    return { text = text, align = "left", fg = "default", draw = Label.draw }

$Box = {}

Box.draw = define(self, x, y, w, h)
    if w < 2 or h < 2 then return null
    edges = Tui.edges
    Tui.border(self.border)
    Tui.fg(self.fg)
    if self.hi != null and self.child != null and Map.has(self.child, "focused")
        if self.child.focused
            Tui.fg(self.hi)
            Tui.attr("bold")
    Tui.box(x, y, w, h, self.title)
    Tui.reset()
    Tui.edges = edges
    if self.child != null
        self.child->draw(x + 1 + self.pad, y + 1, w - 2 - 2 * self.pad, h - 2)

Box.new = define(title, child)
    return { title = title, child = child, border = "rounded", fg = "default", pad = 1, hi = null, draw = Box.draw }

$ListView = {}

ListView.draw = define(self, x, y, w, h)
    if w < 2 or h < 1 then return null
    self.area = [x, y, w, h]
    n = self.items->len()
    self.page = h
    if self.top > n - h then self.top = n - h
    if self.top < 0 then self.top = 0
    if self.selected < self.top then self.top = self.selected
    if self.selected >= self.top + h then self.top = self.selected - h + 1
    if n > h
        w -= 1
        size = h * h / n
        if size < 1 then size = 1
        at = self.top * (h - size) / (n - h)
        Tui.fg(self.fg)
        for i in h
            Tui.move(x + w, y + i)
            if i >= at and i < at + size
                Tui.write("┃")
            else
                Tui.write("│")
    for i in h
        at = self.top + i
        if at >= n then stop
        Tui.reset()
        Tui.fg(self.fg)
        if at == self.selected
            Tui.fg("black")
            Tui.bg(self.hi)
            if not self.focused then Tui.bg("bright_black")
        line = Utf8.fit(self.items[at], w - 2)
        Tui.move(x, y + i)
        Tui.write(" " + line + Tui.repeat(" ", w - 1 - Utf8.width(line)))
    Tui.reset()

ListView.wheel = define(self, step)
    top = self.top + step
    if top > self.items->len() - self.page then top = self.items->len() - self.page
    if top < 0 then top = 0
    at = self.selected
    if at < top then at = top
    if at >= top + self.page then at = top + self.page - 1
    moved = top != self.top or at != self.selected
    self.top = top
    self.selected = at
    return moved

ListView.mouse = define(self, key)
    if key == "wheelup" then return self->wheel(-3)
    if key == "wheeldown" then return self->wheel(3)
    if key == "release" then self.grab = false
    n = self.items->len()
    a = self.area
    if n == 0 or (key != "click" and key != "drag") then return false
    row = Key.mouse.y - a[1]
    if row < 0 then row = 0
    if row >= a[3] then row = a[3] - 1
    if key == "click" then self.grab = n > a[3] and a[3] > 1 and Key.mouse.x == a[0] + a[2] - 1
    at = self.top + row
    if self.grab then at = row * (n - 1) / (a[3] - 1)
    if at >= n and key == "click" then return false
    if at >= n then at = n - 1
    moved = at != self.selected
    self.selected = at
    return moved

ListView.key = define(self, key)
    if Key.ismouse(key) then return self->mouse(key)
    last = self.items->len() - 1
    at = self.selected
    if key == "up" or key == "k" then at -= 1
    if key == "down" or key == "j" then at += 1
    if key == "pgup" then at -= self.page
    if key == "pgdown" then at += self.page
    if key == "home" or key == "g" then at = 0
    if key == "end" or key == "G" then at = last
    if at > last then at = last
    if at < 0 then at = 0
    moved = at != self.selected
    self.selected = at
    return moved

ListView.new = define(items)
    return {
        items = items, selected = 0, top = 0, page = 1, area = [0, 0, 0, 0], grab = false,
        fg = "default", hi = "cyan", focused = true,
        draw = ListView.draw, key = ListView.key, mouse = ListView.mouse, wheel = ListView.wheel,
    }

$Focus = {}

Focus.set = define(self, at)
    n = self.items->len()
    self.at = (at % n + n) % n
    for i in n
        self.items[i].focused = i == self.at
    return true

Focus.under = define(self)
    for i in self.items->len()
        if Tui.hit(self.items[i]) then return i
    return -1

Focus.mouse = define(self, key)
    at = self->under()
    w = self.items[self.at]
    moved = false
    if key->index("wheel") >= 0
        if at < 0 then return false
        w = self.items[at]
    else if key->index("click") >= 0
        if at < 0 then return false
        moved = at != self.at
        self->set(at)
        w = self.items[at]
    if not Map.has(w, "key") then return moved
    return w->key(key) or moved

Focus.key = define(self, key)
    if Key.ismouse(key) then return self->mouse(key)
    if key == "tab" then return self->set(self.at + 1)
    if key == "shift+tab" then return self->set(self.at - 1)
    w = self.items[self.at]
    if Map.has(w, "key") then return w->key(key)
    return false

Focus.current = define(self)
    return self.items[self.at]

Focus.new = define(items)
    f = {
        items = items, at = 0,
        set = Focus.set, key = Focus.key, current = Focus.current, mouse = Focus.mouse, under = Focus.under,
    }
    f->set(0)
    return f

$TextInput = {}

TextInput.draw = define(self, x, y, w, h)
    if w < 1 or h < 1 then return null
    self.area = [x, y, w, h]
    chars = Utf8.split(self.text)
    if self.at < self.left then self.left = self.at
    while Utf8.width(Utf8.slice(chars, self.left, self.at)) >= w
        self.left += 1
    Tui.move(x, y)
    col = 0
    i = self.left
    while col < w
        ch = " "
        if i < chars->len() then ch = chars[i]
        cell = Utf8.cell(ch)
        if col + cell > w then stop
        Tui.reset()
        Tui.fg(self.fg)
        if self.bg != null then Tui.bg(self.bg)
        if i == self.at and self.focused then Tui.attr("reverse")
        Tui.write(ch)
        col += cell
        i += 1
    if self.text == "" and self.hint != ""
        Tui.reset()
        Tui.fg("bright_black")
        if self.bg != null then Tui.bg(self.bg)
        Tui.move(x + 1, y)
        Tui.write(Utf8.fit(self.hint, w - 1))
    Tui.reset()

TextInput.word = define(chars, at, step)
    n = chars->len()
    i = at
    if step < 0
        while i > 0 and chars[i - 1] == " "
            i -= 1
        while i > 0 and chars[i - 1] != " "
            i -= 1
    else
        while i < n and chars[i] == " "
            i += 1
        while i < n and chars[i] != " "
            i += 1
    return i

TextInput.key = define(self, key)
    if key == null then return false
    chars = Utf8.split(self.text)
    n = chars->len()
    at = self.at
    text = self.text
    if Key.ismouse(key)
        if key != "click" and key != "drag" then return false
        col = Key.mouse.x - self.area[0]
        at = self.left
        while at < n and Utf8.cell(chars[at]) <= col
            col -= Utf8.cell(chars[at])
            at += 1
    else if key == "left"
        at -= 1
    else if key == "right"
        at += 1
    else if key == "home" or key == "ctrl+a"
        at = 0
    else if key == "end" or key == "ctrl+e"
        at = n
    else if key == "ctrl+left"
        at = TextInput.word(chars, at, -1)
    else if key == "ctrl+right"
        at = TextInput.word(chars, at, 1)
    else if key == "backspace"
        if at > 0
            text = Utf8.slice(chars, 0, at - 1) + Utf8.slice(chars, at, n)
            at -= 1
    else if key == "delete"
        if at < n then text = Utf8.slice(chars, 0, at) + Utf8.slice(chars, at + 1, n)
    else if key == "ctrl+w"
        from = TextInput.word(chars, at, -1)
        text = Utf8.slice(chars, 0, from) + Utf8.slice(chars, at, n)
        at = from
    else if key == "ctrl+u"
        text = Utf8.slice(chars, at, n)
        at = 0
    else
        if key == "space" then key = " "
        if Utf8.split(key)->len() != 1 then return false
        text = Utf8.slice(chars, 0, at) + key + Utf8.slice(chars, at, n)
        at += 1
    if at < 0 then at = 0
    if at > Utf8.split(text)->len() then at = Utf8.split(text)->len()
    changed = text != self.text or at != self.at
    self.text = text
    self.at = at
    return changed

TextInput.set = define(self, text)
    self.text = text
    self.at = Utf8.split(text)->len()

TextInput.new = define(hint)
    return {
        text = "", at = 0, left = 0, area = [0, 0, 0, 0], hint = hint, fg = "default", bg = null, focused = true,
        draw = TextInput.draw, key = TextInput.key, set = TextInput.set,
    }
